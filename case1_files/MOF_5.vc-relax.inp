 &CONTROL
                       title = 'celula da MOF' ,
                 calculation = 'vc-relax' ,
                restart_mode = 'from_scratch' ,
                  wf_collect = .true. ,
                       nstep = 500 ,
                      outdir = '/home2/alexandre/quantum_espresso/MOF' ,
                      wfcdir = '/home2/alexandre/quantum_espresso/wfc' ,
                  pseudo_dir = '/home2/alexandre/quantum_espresso/psp' ,
                      prefix = 'MOF_5' ,
                     tprnfor = .true.  
                     tstress = .true.
	           verbosity = 'high',
  /
 
  &SYSTEM
                       ibrav = 0 ,
                   !celldm(1) = 48.897,
                         nat = 424 ,
                        ntyp = 4,
                     ecutwfc = 25 ,
                     ecutrho = 100 ,
			nr1  = 80,
			nr2  = 80,
			nr3  = 80
                       nosym = .false. ,
                        nbnd = 960 ,
                 occupations = 'smearing',
                    smearing = 'gaussian' ,
                     degauss = 0.1 ,
                       !nspin = 2 ,
   !starting_magnetization(1) = 0.5 ,
                  !lda_plus_u = .true.
           !U_projection_type = 'ortho-atomic' 
                   !Hubbard_U = 5.0 
                   !Hubbard_J = 1.0    
                    vdw_corr = 'DFT-D3' 
/ 
 &ELECTRONS
                 mixing_beta = 0.3 ,
                    conv_thr = 1.0e-6 ,
            electron_maxstep = 1600 ,
 /
 &IONS

                ion_dynamics = 'bfgs',
           pot_extrapolation = 'second-order',
           wfc_extrapolation = 'second-order',
 /
 &CELL   
cell_dofree='all'           
/

