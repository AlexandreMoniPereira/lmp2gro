; RUN CONTROL
integrator               = md        ; Leap-frog algorithm
tinit                    = 0         ; Starting time (ps)
dt                       = 0.001     ; Time step (ps) - 1 fs
nsteps                   = 100000    ; Total steps = 100 ps
nstcomm                  = 100       ; COM removal frequency

; OUTPUT CONTROL
nstxout                  = 0         ; No full precision trajectory
nstvout                  = 0         ; No velocity output
nstfout                  = 0         ; No force output
nstlog                   = 500       ; Log output every 0.5 ps
nstenergy                = 500       ; Energy output every 0.5 ps
nstxout-compressed       = 500       ; Compressed trajectory every 0.5 ps

; NEIGHBOR SEARCHING
cutoff-scheme            = verlet    ; Verlet buffer scheme
nstlist                  = 20        ; Neighbor list update frequency
ns_type                  = grid      ; Grid-based neighbor searching
pbc                      = xyz       ; 3D periodic boundary conditions
rlist                    = 1.2       ; Neighbor list cutoff (nm)

; ELECTROSTATICS
coulombtype              = PME       ; Particle Mesh Ewald
rcoulomb                 = 1.2       ; Real space cutoff (nm)

; VAN DER WAALS
vdwtype                  = cutoff    ; Cut-off for VdW
vdw-modifier             = potential-switch  ; Switch function
rvdw-switch              = 1.0       ; Switch start distance (nm)
rvdw                     = 1.2       ; VdW cutoff (nm)
DispCorr                 = EnerPres  ; Long-range dispersion corrections

; PME PARAMETERS
fourierspacing           = 0.12      ; Grid spacing for FFT (nm)
pme_order                = 4         ; B-spline interpolation order
ewald_rtol               = 1e-06     ; Relative tolerance for Ewald
epsilon_surface          = 0         ; No vacuum-surface correction

; TEMPERATURE COUPLING
tcoupl                   = v-rescale ; Thermostat for annealing
tc_grps                  = system    ; Thermostat group
tau_t                    = 1.0       ; Thermostat time constant
ref_t                    = 430       ; Reference temperature (initial)

; PRESSURE COUPLING
Pcoupl                   = no        ; No pressure coupling for NVT

; VELOCITY INITIALIZATION
continuation             = yes       ; Continuing from previous simulation
gen_vel                  = no        ; Use velocities from input

; CONSTRAINT ALGORITHM
constraints              = h-bonds   ; Constrain bonds involving hydrogen
constraint-algorithm     = lincs     ; LINCS constraint algorithm
lincs-order              = 4         ; Expansion order for constraint coupling matrix
lincs-iter               = 1         ; Number of iterations for LINCS
lincs-warnangle          = 30        ; Warning threshold for bond rotation

; SIMULATED ANNEALING
annealing                = single    ; Single annealing cycle
annealing_npoints        = 43        ; Number of temperature points
annealing_time           = 0 42500 47500 52500 57500 62500 67500 72500 77500 82500 87500 92500 97500 102500 107500 112500 117500 122500 127500 132500 137500 142500 147500 152500 157500 162500 167500 172500 177500 182500 187500 192500 197500 202500 207500 212500 217500 222500 227500 232500 237500 242500 247500
annealing_temp           = 353 523 523 503 503 483 483 463 463 443 443 423 423 403 403 383 383 363 363 343 343 323 323 303 303 283 283 263 263 243 243 223 223 203 203 183 183 163 163 143 143 123 123
