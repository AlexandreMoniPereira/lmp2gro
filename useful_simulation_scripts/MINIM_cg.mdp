; ENERGY MINIMIZATION PARAMETERS
integrator               = cg      ; Conjugate Gradient algorithm for energy minimization
nsteps                   = 10000   ; Maximum number of minimization steps (10000 is conservative)
nstcgsteep               = 10      ; Frequency of steepest descent steps within CG (not in recent GROMACS)

; CONSTRAINT SETTINGS
constraints              = none    ; No constraints during minimization (bonds can stretch)
lincs_order              = 8       ; LINCS order (irrelevant since constraints = none)

; MINIMIZATION CONVERGENCE CRITERIA
emtol                    = 20      ; Convergence tolerance - max force < 20 kJ/mol/nm
emstep                   = 0.01    ; Initial step size for minimization (nm)

; CENTER OF MASS MOTION CONTROL
comm-mode                = Linear  ; Linear center of mass motion removal
nstcomm                  = 1       ; Frequency of COM removal (steps) - not critical for EM

; OUTPUT FREQUENCIES
nstcalcenergy            = 1       ; Calculate energy every step
nstlog                   = 1       ; Write to log file every step
nstenergy                = 1       ; Write energy to .edr file every step
nstxout                  = 1       ; Write coordinates every step (creces .trr files)

; NEIGHBOR SEARCHING SETTINGS
ns_type                  = grid    ; Use grid-based neighbor searching (efficient)
cutoff-scheme            = verlet  ; Modern Verlet cutoff scheme
nstlist                  = 10      ; Update neighbor list every 10 steps
rlist                    = 1.2     ; Neighbor list cutoff radius (nm)

; ELECTROSTATICS AND VAN DER WAALS
coulombtype              = PME     ; Particle Mesh Ewald for long-range electrostatics
rcoulomb                 = 1.2     ; Coulomb cutoff radius (nm)
rvdw                     = 1.2     ; Van der Waals cutoff radius (nm)

; THERMOSTAT AND BAROSTAT (DISABLED FOR MINIMIZATION)
Tcoupl                   = no      ; No temperature coupling during minimization
Pcoupl                   = no      ; No pressure coupling during minimization

; VELOCITY INITIALIZATION
gen_vel                  = no      ; Do not generate velocities for minimization

; PERIODIC BOUNDARY CONDITIONS
pbc                      = xyz     ; Periodic boundaries in all directions
