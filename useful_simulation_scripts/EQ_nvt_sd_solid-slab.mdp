; RUN CONTROL
integrator               = sd        ; Stochastic dynamics (Langevin)
tinit                    = 0         ; Starting time (ps)
dt                       = 0.001     ; Time step (ps) - 1 fs
nsteps                   = 10000000  ; Total steps = 10000 ps (10 ns)
nstcomm                  = 100       ; COM removal frequency

; OUTPUT CONTROL
nstxout                  = 0         ; No full precision trajectory output
nstvout                  = 0         ; No velocity output
nstfout                  = 0         ; No force output
nstlog                   = 500       ; Log output every 0.5 ps
nstenergy                = 500       ; Energy output every 0.5 ps
nstxout-compressed       = 500       ; Compressed trajectory every 0.5 ps

; NEIGHBOR SEARCHING
cutoff-scheme            = verlet    ; Verlet buffer scheme
nstlist                  = 100       ; Neighbor list update frequency
ns_type                  = grid      ; Grid-based neighbor searching
pbc                      = xyz       ; 3D periodic boundary conditions
rlist                    = 1.2       ; Neighbor list cutoff (nm)

; ELECTROSTATICS
coulombtype              = PME       ; Particle Mesh Ewald
rcoulomb                 = 1.2       ; Real space cutoff (nm)

; VAN DER WAALS
vdwtype                  = cutoff    ; Cut-off for VdW
vdw-modifier             = potential-switch  ; Switch function
rvdw-switch              = 1.0       ; Switch start distance (nm)
rvdw                     = 1.2       ; VdW cutoff (nm)
DispCorr                 = EnerPres  ; Long-range dispersion corrections

; PME PARAMETERS
fourierspacing           = 0.12      ; Grid spacing for FFT (nm)
pme_order                = 4         ; B-spline interpolation order
ewald_rtol               = 1e-06     ; Relative tolerance for Ewald
epsilon_surface          = 0         ; No vacuum-surface correction

; TEMPERATURE COUPLING - LANGEVIN DYNAMICS
; NOTE: With integrator = sd, temperature is controlled via bd-fric, not tcoupl
tcoupl                   = no        ; REMOVED: Not needed with Langevin dynamics
; tc_grps                = system    ; REMOVED: Not used without tcoupl
; tau_t                  = 1.0       ; REMOVED: Not used without tcoupl
ref_t                    = 430       ; Reference temperature for reporting

; LANGEVIN PARAMETERS (REQUIRED)
bd-fric                  = 1         ; Friction coefficient (typical: 1-10 ps⁻¹)

; PRESSURE COUPLING (DISABLED FOR NVT)
Pcoupl                   = no        ; No pressure coupling

; VELOCITY INITIALIZATION - CORRECTED
continuation             = no        ; Starting new simulation
gen_vel                  = yes       ; Generate new velocities
gen_temp                 = 430       ; Temperature for velocity generation (K)
gen_seed                 = 173529    ; Random seed for reproducibility

; CONSTRAINT ALGORITHM
constraints              = h-bonds   ; Constrain bonds involving hydrogen
constraint-algorithm     = lincs     ; LINCS constraint algorithm
lincs-order              = 4         ; Expansion order for constraint coupling matrix
lincs-iter               = 1         ; Number of iterations for LINCS
lincs-warnangle          = 30        ; Warning threshold for bond rotation (degrees)

; FROZEN GROUPS - SOLID SLAB SPECIFIC
freezegrps               = UFF MOL SOL  ; Groups to freeze (atoms, molecules, solvent)
freezedim                = Y Y Y N N N N N N  ; Freeze X,Y,Z positions; allow rotations
